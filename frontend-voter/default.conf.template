# ------------------------------
# 🌐 Cloud Run Frontend Template
# Compatible with React/Vite + PWA
# ------------------------------

# Define MIME types for webmanifest & JSON
types {
    application/manifest+json webmanifest;
    application/json json;
}

server {
    # Cloud Run injects the PORT env var
    listen ${PORT};

    server_name _;

    # Serve the built static site
    root /usr/share/nginx/html;
    index index.html index.htm;

    # ------------------------------
    # Main app routes (SPA fallback)
    # ------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ------------------------------
    # Static asset caching (CSS/JS/Images)
    # ------------------------------
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|webp)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ------------------------------
    # Service worker — must bypass cache
    # ------------------------------
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # ------------------------------
    # Web App Manifest — must not be cached
    # ------------------------------
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # ------------------------------
    # Error handling (fallback to SPA)
    # ------------------------------
    error_page 404 /index.html;

    # ------------------------------
    # Logs for debugging (optional)
    # ------------------------------
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
