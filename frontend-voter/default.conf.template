# ------------------------------
# 🌐 Cloud Run Frontend Template
# Works with React / Vue / Svelte + Vite
# Fully SPA + PWA compatible
# ------------------------------

# Define MIME types for manifest and JSON
types {
    application/manifest+json webmanifest;
    application/json json;
}

server {
    # Cloud Run injects the PORT environment variable dynamically
    listen ${PORT};

    server_name _;

    # Serve your built static files
    root /usr/share/nginx/html;
    index index.html index.htm;

    # ------------------------------
    # Main app route (SPA fallback)
    # ------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ------------------------------
    # Cache static assets aggressively
    # ------------------------------
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ------------------------------
    # Service Worker — must bypass cache
    # ------------------------------
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # ------------------------------
    # Manifest file — must not be cached
    # ------------------------------
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # ------------------------------
    # Handle 404s (redirect to index.html)
    # ------------------------------
    error_page 404 /index.html;

    # ------------------------------
    # Logging (visible in Cloud Run console)
    # ------------------------------
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
