server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Service worker and manifest should not be cached aggressively
    location /sw.js {
        add_header Cache-Control "no-cache";
    }

    location /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }
}
